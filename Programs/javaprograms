// Second largest distinct number in list

public class SecondLargest {

    public static Integer findSecondLargest(List<Integer> nums) {
        Integer largest = null;
        Integer secondLargest = null;

        for (Integer num : nums) { 
            if (num == null) {
                continue;
            }

            if (largest == null || num > largest) {
                secondLargest = largest;
                largest = num;
            } else if (num < largest &&
                       (secondLargest == null || num > secondLargest)) {
                secondLargest = num;
            }
        }

        return secondLargest;
    }

    public static void main(String[] args) {
        List<Integer> nums = Arrays.asList(10, 5, 20, 20, 8, 15);

        Integer result = findSecondLargest(nums);

        if (result == null) {
            System.out.println("Second largest distinct number does not exist");
        } else {
            System.out.println("Second largest: " + result);
        }
    }
}

