public class PrimeNumberCheck {
    public static void main(String[] args) {
        int i = 15;
        int j = 0;

        for (int k = 1; k <= i; k++) {
            if (i % k == 0) {
                j++;
            }
        }

        if (j == 2) {
            System.out.println(i + " is a prime");
        } else {
            System.out.println(i + " is not a prime");
        }
    }
}
