// Sort it to ascending order and get the second last element. But this is not efficient. Instead, we can iterate through the array and keep track of the largest and second largest numbers.
public static Integer secondLargest(int[] values) {
    Integer largest = null;
    Integer second = null;
    int [] values = {10, 5, -10, -8}; // Example array

    for (int value : values) {
        if (largest == null || value > largest) { // If the current value is greater than the largest found so far
            if (largest != null) { // If largest is not null, update second to the previous largest
                second = largest; // Update second largest to the previous largest
            }
            largest = value; // Update largest to the current value
        } else if (value != largest && (second == null || value > second)) {// If second is null or the current value is greater than the second largest found so far
            second = value;// Update second largest to the current value
        }
    }

    return second; // Return the second largest number found, or null if there isn't one - 
}
