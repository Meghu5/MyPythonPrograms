#regex pattern to extract test case results from a CI log

ci_log = """
[2026-09-18 14:02:11] TC001 PASS 1.20s
[2026-09-18 14:02:15] TC002 FAIL 2.80s
[2026-09-18 14:02:20] TC003 PASS 0.90s
[2026-09-18 14:02:25] TC004 BLOCKED 0.00s
"""

pattern = re.compile(
    r"\[(?P<timestamp>[^\]]+)\]\s+" #timestamp is captured within square brackets, using a named group 'timestamp' that matches any character except a closing bracket
    r"(?P<test_id>TC\d{3})\s+" #test ID is captured using a named group 'test_id' that matches 'TC' followed by exactly 3 digits
    r"(?P<status>PASS|FAIL|BLOCKED)\s+" #status is captured using a named group 'status' that matches one of the three possible values
    r"(?P<duration>\d+\.\d+)s" #duration is captured using a named group 'duration' that matches a decimal number
)

results = []

for match in pattern.finditer(ci_log): #Iterate over all matches of the pattern in the CI log
    record = {
        "timestamp": match.group("timestamp"),
        "test_id": match.group("test_id"),
        "status": match.group("status"),
        "duration": float(match.group("duration"))
    }
    results.append(record)

print(results)

failed_tests = [
    result["test_id"]
    for result in results
    if result["status"] == "FAIL"
]

total_duration = sum(result["duration"] for result in results) 

print("Failed tests:", failed_tests)
print("Total duration:", total_duration)

# Function to mask sensitive values in a given text using regex patterns

def mask_sensitive_values(text: str) -> str:
    patterns = [
        (r"(?i)(password=)[^\s&]+", r"\1***"),
        (r"(?i)(token=)[^\s&]+", r"\1***"),
        (r"(?i)(authorization:\s*bearer\s+)[^\s]+", r"\1***"),
        (r"(?i)(api[_-]?key=)[^\s&]+", r"\1***")
    ]

    masked_text = text

    for pattern, replacement in patterns:
        masked_text = re.sub(pattern, replacement, masked_text)

    return masked_text


