// Thread local - parallel execution $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

public class DriverManager {

    private static final ThreadLocal<WebDriver>// ThreadLocal gives each test thread its own WebDriver instance.
        DRIVER = new ThreadLocal<>();

    public static void setDriver(WebDriver driver) {
        DRIVER.set(driver);
    }

    public static WebDriver getDriver() {
        return DRIVER.get();
    }

    public static void unload() {
        DRIVER.remove();
    }
} 

