
import re

booking_text = """
Booking confirmed.
PNR: EY7K9P
Flight: EY101
Travel Date: 2026-10-05
Passenger Email: meghana@example.com
Payment Token: tok_abc123xyz
""" #string containing booking details including PNR, flight number, travel date, passenger email, and payment token

patterns = {
    "pnr": re.compile(r"\b[A-Z0-9]{6}\b"), #PNR is typically 6 alphanumeric characters - b- boundary, A-Z uppercase letters, 0-9 digits, {6} exactly 6 characters
    "flight": re.compile(r"\b[A-Z]{2}\d{3,4}\b"),#Flight number is typically 2 letters followed by 3 or 4 digits
    "date": re.compile(r"\b\d{4}-\d{2}-\d{2}\b"),#Date is in YYYY-MM-DD format
    "email": re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"),#Email pattern matches standard email formats
    "token": re.compile(r"\b(tok_[A-Za-z0-9]+)\b")#Token pattern matches a string starting with 'tok_' followed by alphanumeric characters
} # defining regex patterns for PNR, flight number, travel date, passenger email, and payment token

pnr_match = patterns["pnr"].search(booking_text) # Search for PNR in the booking text
flight_match = patterns["flight"].search(booking_text) # Search for flight number in the booking text
date_match = patterns["date"].search(booking_text) # Search for travel date in the booking text
email_match = patterns["email"].search(booking_text) # Search for passenger email in the booking text
token_match = patterns["token"].search(booking_text) # Search for payment token in the booking text

validation_errors = []

if not pnr_match:
    validation_errors.append("PNR not found")

if not flight_match:
    validation_errors.append("Flight number not found")

if not date_match:
    validation_errors.append("Travel date not found")

if not email_match:
    validation_errors.append("Passenger email not found")

if not token_match:
    validation_errors.append("Payment token not found")

if validation_errors:
    print("Validation FAILED")
    for error in validation_errors:
        print("-", error)
else:
    print("Validation PASSED")
    print("PNR:", pnr_match.group())
    print("Flight:", flight_match.group())
    print("Travel Date:", date_match.group())
    print("Passenger Email:", email_match.group())

    masked_token = re.sub(
        r"(?<=tok_)[A-Za-z0-9]+",
        "***",
        token_match.group()
    )

    print("Payment Token:", masked_token)
    
  

